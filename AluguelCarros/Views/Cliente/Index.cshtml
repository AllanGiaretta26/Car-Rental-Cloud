@model IEnumerable<AluguelCarros.Models.Cliente>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Clientes</h2>
    <a href="/Cliente/Criar" class="btn btn-primary">+ Cadastrar cliente</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhum cliente cadastrado ainda.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Email</th>
                <th>CPF</th>
                <th>Telefone</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Nome</td>
                    <td>@cliente.Email</td>
                    <td>@cliente.CPF</td>
                    <td>@cliente.Telefone</td>
                    <td>
                        <a href="/Cliente/Editar/@cliente.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a href="/Cliente/Excluir/@cliente.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}