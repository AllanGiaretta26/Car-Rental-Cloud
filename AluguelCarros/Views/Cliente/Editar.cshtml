@model AluguelCarros.Models.Cliente

@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Editar Cliente</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Cliente/Editar">
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Nome</label>
                        <input type="text" name="Nome" class="form-control" value="@Model.Nome" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" name="Email" class="form-control" value="@Model.Email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">CPF</label>
                        <input type="text" name="CPF" class="form-control" value="@Model.CPF" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Telefone</label>
                        <input type="text" name="Telefone" class="form-control" value="@Model.Telefone" required />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Salvar</button>
                        <a href="/Cliente" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>