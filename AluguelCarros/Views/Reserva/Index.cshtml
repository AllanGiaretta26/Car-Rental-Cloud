@model IEnumerable<AluguelCarros.Models.Reserva>

@{
    ViewData["Title"] = "Reservas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Reservas</h2>
    <a href="/Reserva/Criar" class="btn btn-primary">+ Nova reserva</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">Nenhuma reserva cadastrada ainda.</div>
}
else
{
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Cliente</th>
                <th>Veículo</th>
                <th>Data Início</th>
                <th>Data Fim</th>
                <th>Valor Total</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reserva in Model)
            {
                <tr>
                    <td>@reserva.Cliente?.Nome</td>
                    <td>@reserva.Veiculo?.Modelo</td>
                    <td>@reserva.DataInicio.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.DataFim.ToString("dd/MM/yyyy")</td>
                    <td>@reserva.ValorTotal.ToString("C", new System.Globalization.CultureInfo("pt-BR"))</td>
                    <td>
                        @if (reserva.Status == "Aprovada")
                        {
                            <span class="badge bg-success">Aprovada</span>
                        }
                        else if (reserva.Status == "Cancelada")
                        {
                            <span class="badge bg-danger">Cancelada</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark">Pendente</span>
                        }
                    </td>
                    <td>
                        @if (reserva.Status == "Pendente")
                        {
                            <a href="/Reserva/Aprovar/@reserva.Id" class="btn btn-sm btn-success">Aprovar</a>
                        }
                        @if (reserva.Status != "Cancelada")
                        {
                            <a href="/Reserva/Cancelar/@reserva.Id" class="btn btn-sm btn-outline-danger">Cancelar</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}