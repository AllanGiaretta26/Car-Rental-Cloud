@model AluguelCarros.Models.Reserva

@{
    ViewData["Title"] = "Nova Reserva";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Nova Reserva</h5>
            </div>
            <div class="card-body">
                <form method="post" action="/Reserva/Criar">
                    <div class="mb-3">
                        <label class="form-label">Cliente</label>
                        <select name="ClienteId" class="form-select" required>
                            <option value="">-- Selecione um cliente --</option>
                            @foreach (var item in (SelectList)ViewBag.Clientes)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Veículo disponível</label>
                        <select name="VeiculoId" class="form-select" required>
                            <option value="">-- Selecione um veículo --</option>
                            @foreach (var item in (SelectList)ViewBag.Veiculos)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Data de Início</label>
                        <input type="date" name="DataInicio" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Data de Fim</label>
                        <input type="date" name="DataFim" class="form-control" required />
                    </div>
                    <div class="alert alert-light border">
                        O valor total será calculado automaticamente com base nos dias e no valor da diária do veículo.
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Confirmar Reserva</button>
                        <a href="/Reserva" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>